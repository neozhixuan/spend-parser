{
  "name": "spend-parser",
  "version": "1.0.0",
  "private": true,
  "description": "Parses SC, POSB/DBS and PayLah! e-statements in the browser, categorises them and saves to your own Google Sheet.",
  "type": "module",
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
